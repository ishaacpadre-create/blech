{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/suggest", "destination": "/api/suggest" },
    { "source": "/api/generate", "destination": "/api/generate" },
    { "source": "/api/prices", "destination": "/api/prices" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
